# Settings for `docker compose` in this folder. Copy to deploy/.env and fill in the four secrets.
# Make each secret with:  openssl rand -hex 32

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres superuser (only used by the database container itself).
POSTGRES_PASSWORD=
# Password of the `hotel` role the app connects as (letters and digits only: it goes inside a URL).
APP_DB_PASSWORD=
# Signs sign-in cookies and guest invoice links. 32+ characters.
AUTH_SECRET=
# Encrypts OTA tokens and API keys stored in the database. 64 hex characters (32 bytes).
CREDENTIALS_KEY=

# ── Address ───────────────────────────────────────────────────────────────────
# The address staff and guests open. Used in WhatsApp invoice links, payment links, the booking engine link and
# the print agent. https:// makes sign-in cookies Secure; a LAN install on http://192.168.1.20:3000 also works.
APP_URL=http://localhost:3000
# Port on this server. Put a reverse proxy (Caddy, nginx) with HTTPS in front of it for internet access.
APP_PORT=3000
# Name in the browser tab and sidebar (fixed when the image is built).
APP_NAME=AsiaTech

# ── Providers (safe defaults: nothing leaves the server) ─────────────────────
WHATSAPP_PROVIDER=console
PAYMENTS_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
CHANNEL_PROVIDER=mock
# CHANNEX_API_KEY=
# Shared secret OTAs send in the x-webhook-secret header (inbound OTA bookings are refused without it).
# OTA_WEBHOOK_SECRET=

# Email: `console` only logs. `smtp` works with Gmail / Google Workspace (app password), Zoho, Amazon SES, Brevo.
EMAIL_PROVIDER=console
# SMTP_URL=smtps://user%40yourhotel.com:app-password@smtp.gmail.com:465
# EMAIL_FROM=bills@yourhotel.com

# ── File storage ──────────────────────────────────────────────────────────────
# `local` keeps uploads in the `uploads` Docker volume. `s3` for AWS S3 / Cloudflare R2 / MinIO (private bucket).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=asiatech-hotel-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Backups ───────────────────────────────────────────────────────────────────
# The worker backs up the database (and local uploads) every night into the `backups` volume and keeps
# BACKUP_KEEP_DAYS of them. Status, "Back up now" and downloads: platform console → Backups.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Also copy every backup off this server (strongly advised): a private bucket, reached with the S3_* settings
# above (S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY). It can be the uploads bucket.
# BACKUP_S3_BUCKET=asiatech-hotel-backups
