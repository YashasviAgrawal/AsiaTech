# PostgreSQL connection string
DATABASE_URL=postgresql://hotel:hotel@localhost:5432/hotel_os

# Long random string used to sign session cookies (openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used in links sent on WhatsApp / email)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AsiaTech

# Providers: "console" logs messages instead of sending them (safe default for dev)
WHATSAPP_PROVIDER=console
PAYMENTS_PROVIDER=mock
CHANNEL_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# CHANNEX_API_KEY=

# File storage for uploads (guest IDs, bills, room photos, logo). `local` keeps files on disk under STORAGE_DIR.
# Guest IDs and bills are private (staff only); room photos and branding are public.
STORAGE_DRIVER=local
STORAGE_DIR=.data/uploads
