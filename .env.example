# PostgreSQL connection string
DATABASE_URL=postgresql://hotel:hotel@localhost:5432/hotel_os

# Long random string used to sign session cookies (openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string

# Public address of the app (links in WhatsApp / email, payment links, booking engine, print agent).
# Read at run time, so one build serves any domain. https:// makes the sign-in cookie Secure.
APP_URL=http://localhost:3000
# Name in the browser tab and sidebar (fixed at build time)
NEXT_PUBLIC_APP_NAME=AsiaTech

# Providers: "console" logs messages instead of sending them (safe default for dev)
WHATSAPP_PROVIDER=console
PAYMENTS_PROVIDER=mock
CHANNEL_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CHANNEX_API_KEY=
# Shared secret OTAs send in the x-webhook-secret header (required in production)
# OTA_WEBHOOK_SECRET=

# Email (invoices with the PDF attached, night audit report, alerts). `console` only logs them.
# `smtp` works with any mail service: Gmail / Google Workspace (app password), Zoho, Amazon SES, Brevo.
EMAIL_PROVIDER=console
# SMTP_URL=smtps://user%40yourhotel.com:app-password@smtp.gmail.com:465
# EMAIL_FROM=bills@yourhotel.com

# File storage for uploads (guest IDs, bills, room photos, logo). `local` keeps files on disk under STORAGE_DIR.
# Guest IDs and bills are private (staff only); room photos and branding are public.
STORAGE_DRIVER=local
STORAGE_DIR=.data/uploads
# For STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, MinIO). Use a PRIVATE bucket: files are served through /files.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   (AWS: https://s3.ap-south-1.amazonaws.com)
# S3_REGION=auto                                              (AWS: ap-south-1)
# S3_BUCKET=asiatech-hotel-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true                                    (default: true except on amazonaws.com)

# Encryption key for OTA tokens and API keys stored in the database (AES-256-GCM). 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; in development a key is derived from AUTH_SECRET.
CREDENTIALS_KEY=

# Rate limits (sign-in, booking engine, webhooks, invoice links). `memory` is per server process; with more than
# one app server behind a load balancer use `postgres` so all servers share the counts.
RATE_LIMIT_STORE=memory
